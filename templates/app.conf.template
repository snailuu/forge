# Nginx 应用配置模板
# 说明：此文件用于定义单个应用的配置
# 初始化时会替换以下占位符：
# - {{PROJECT_NAME}}   项目名称
# - {{PROJECT_ROOT}}   项目根目录
# - {{SERVER_NAME}}    域名或 IP
#
# 使用步骤：
# 1. 复制此文件为 /etc/nginx/conf.d/your-app-name.conf
# 2. 修改下面的配置（server_name、root 等）
# 3. 重载 Nginx：sudo nginx -t && sudo systemctl reload nginx
#
# 示例：
# - 复制为 /etc/nginx/conf.d/ai-coach.conf
# - 复制为 /etc/nginx/conf.d/admin-panel.conf
# - 复制为 /etc/nginx/conf.d/api.conf
#
# 主 Nginx 配置会自动加载 /etc/nginx/conf.d/*.conf

server {
    # ========== 必须修改 ==========
    listen 80;                              # 监听端口（通常 80，如有多个服务需要不同端口）
    server_name {{SERVER_NAME}};           # ⭐ 可按需修改

    # ========== 静态文件托管模式 ==========
    # 如果是前端 SPA（React/Vue/Angular）应用，使用这个配置
    root {{PROJECT_ROOT}};                 # ⭐ 可按需修改
    index index.html;

    # ========== API 代理配置（包含 WebSocket 支持）==========
    # 默认保留 /api 前缀，如需剥离 /api，可改为：proxy_pass http://localhost:3000/;
    location /api/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;

        # WebSocket 支持
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 标准代理头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 超时设置
        proxy_read_timeout 86400;
    }

    # ========== 可选：WebSocket 支持（独立 WS 路径）==========
    # 如果应用需要 WebSocket 连接（如实时通知），取消注释
    # location /ws {
    #     proxy_pass http://localhost:3001/;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection $connection_upgrade;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_read_timeout 86400;
    # }

    # ========== 可选：将 Node.js 后端完全代理到另一个端口 ==========
    # 如果整个应用运行在 Node.js 3000 端口，可以这样配置
    # location / {
    #     proxy_pass http://localhost:3000/;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection $connection_upgrade;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_read_timeout 86400;
    # }

    # ========== SPA 路由支持 ==========
    # 将所有找不到的请求重定向到 index.html（让前端路由处理）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ========== 静态资源缓存 ==========
    # JS/CSS/图片等长期不变，缓存 1 年
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ========== 禁止访问隐藏文件 ==========
    location ~ /\. {
        deny all;
    }

    # ========== 禁止访问备份文件 ==========
    location ~ ~$ {
        deny all;
    }

    # ========== 日志文件 ==========
    # 每个应用的日志单独保存，便于排查问题
    access_log /var/log/nginx/{{PROJECT_NAME}}_access.log;
    error_log /var/log/nginx/{{PROJECT_NAME}}_error.log warn;
}

